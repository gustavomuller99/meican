MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MEICAN_PORT=80
MEICAN_VERSION=3.3.0

# CIRCUIT_LIFECYCLE_LOGGER
# accepted values
# 'blockchain' -> saves Connection, ConnectionAuth and ConnectionEvent updates for blockchain observability
# 'trace' -> writes Connection, ConnectionAuth, ConnectionEvent and Workflow updates as Yii trace logs
CIRCUIT_LIFECYCLE_LOGGER=blockchain

# CIRCUIT_LIFECYCLE_CLIENT
# accepted values
# 'blockchain' -> stores the blockchain observability data structures directly in the blockchain
# 'ipfs' -> stores the blockchain observability data structures CID in the blockchain and the actual content into IPFS
CIRCUIT_LIFECYCLE_CLIENT=ipfs

IPFS_RPC_URL=http://ipfs:5001
BLOCKCHAIN_SIDECAR_URL=http://blockchain-sidecar:3000
BLOCKCHAIN_RPC_URL=http://hardhat:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_SIGNER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
BLOCKCHAIN_SIGNER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266